# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ruff_cache/
.venv-weasy/

# Node scratch space, Folio has no JS runtime dependency
node_modules/

# WeasyPrint native libraries, resolved per platform and never committed
.font-libs/

# Generated document and diagram examples, rebuild via: python3 scripts/build.py
assets/examples/

# Packaged skill artifact, rebuild via: bash scripts/package-skill.sh
/dist/

/tmp/
*.log

# Slides build artifact: the pptx script writes beside its own template, and
# build.py moves it into assets/examples/ under the target name.
assets/templates/output.pptx

# Local agent scratch directories
.superpowers/
docs/superpowers/

# Local implementation plans for the document engine program. These describe
# in-progress engineering logic and stay out of the published repository.
/docs/plans/

# Local render scratch space for showcase review
/build/

# Local reliability audit records and comparison tooling
/docs/audits/
/scripts/repair_evidence.py
/scripts/build_repair_report.py
/scripts/templates/repair-comparison.html

# Exploration: rendered colour-scheme pages are intermediate, the comparison
# page keeps its own copies.
dist/color-schemes/

# Local engineering process records. Plans, task lists, status reports and the
# audit trail that produced them: in-progress engineering logic rather than the
# design a reader needs, which is the same reason /docs/plans/ is out.
/docs/architecture/

# The colour and font investigation's working notes. The design that came out of
# it is stated in references/design.md and the three documents kept beside it;
# these are the trail, and they stay local.
/docs/exploration/color-architecture-review.md
/docs/exploration/color-font-current-state.md
/docs/exploration/color-font-research.md
/docs/exploration/color-font-support-audit.md
/docs/exploration/color-font-prototype-report.md
/docs/exploration/color-font-remediation-plan.md
/docs/exploration/drawing-series-bridge-plan.md
