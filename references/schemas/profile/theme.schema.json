{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.dev/schema/theme-profile-1.0.json",
  "title": "Folio Theme Profile",
  "description": "Appearance only: colour and strokes. Deliberately carries no type size, leading or page rule, so switching a theme cannot reflow a document.",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "invariants": {
      "type": "object",
      "additionalProperties": true
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "genre": {
            "type": "string"
          },
          "colors": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/colour"
            }
          },
          "accent": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/colour"
            }
          },
          "decoration": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rule_width_pt": {
                "type": "number",
                "minimum": 0
              },
              "corner_radius_pt": {
                "type": "number",
                "minimum": 0
              },
              "hairline": {
                "$ref": "#/$defs/colour"
              }
            }
          },
          "overridable": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/colour"
            },
            "description": "What a value means: positive, caution, negative, informative, and a tint for each. Used together with a word, never alone."
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/colour"
            },
            "description": "What a chart series is. Categorical hues imply no order, the sequential ramp is ordered, the diverging poles sit either side of a baseline."
          },
          "default": {
            "type": "boolean",
            "description": "Marks the theme a document gets when it names none. Exactly one profile in the repository may carry it."
          },
          "palette": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/colour"
            },
            "description": "Raw colours, each written once. Only the color layer references these; a template never reads one."
          },
          "color": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/$defs/colour"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/colour"
                      },
                      {
                        "$ref": "#/$defs/palette_ref"
                      }
                    ]
                  }
                }
              ]
            },
            "description": "Semantic roles. Each is either a colour or a reference to a palette entry. The projection derives one CSS variable per path."
          }
        },
        "anyOf": [
          {
            "required": [
              "colors"
            ]
          },
          {
            "required": [
              "color"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "colour": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "palette_ref": {
      "type": "object",
      "required": [
        "palette"
      ],
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A reference to a palette entry, by name."
    }
  }
}
