{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/timeline.schema.json",
  "title": "Folio Timeline Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "events"],
  "allOf": [{"if":{"properties":{"canvas":{"const":"poster"}},"required":["canvas"]},"else":{"properties":{"height":{"maximum":800}}}}],
  "properties": {
    "schema_version": {"const": "3.0"}, "kind": {"const": "timeline"},
    "title": {"$ref": "#/$defs/non-empty-string"},
    "events": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"$ref": "#/$defs/event"}},
    "scale": {"enum": ["temporal", "ordinal"]}, "focus": {"type": ["string", "null"]},
    "canvas": {"enum": ["figure", "poster"]},
    "width": {"const": 960}, "height": {"type": "integer", "minimum": 500, "maximum": 4000, "multipleOf": 4},
    "language": {"$ref": "#/$defs/nullable-string"}
  },
  "$defs": {
    "nullable-string": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/non-empty-string"}]},
    "non-empty-string": {"type": "string", "pattern": ".*\\S.*"},
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "date", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/non-empty-string"}, "date": {"type": "string", "format": "date"},
        "label": {"$ref": "#/$defs/non-empty-string"}, "description": {"type": ["string", "null"]},
        "importance": {"enum": ["focal", "normal", "background"]}
      }
    }
  }
}
