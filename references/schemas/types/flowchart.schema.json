{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/flowchart.schema.json",
  "title": "Folio Flowchart Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kind": {"const": "flowchart"},
    "title": {"$ref": "#/$defs/non-empty-string"},
    "focus": {"type": ["string", "null"]},
    "width": {"type": "integer", "minimum": 320},
    "height": {"type": "integer", "minimum": 240},
    "language": {"$ref": "#/$defs/non-empty-string"},
    "axis": {"enum": ["top-down", "left-right"]},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "non-empty-string": {"type": "string", "pattern": ".*\\S.*"},
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/non-empty-string"},
        "type": {"enum": ["step", "decision", "terminal", "data", "subprocess"]},
        "label": {"$ref": "#/$defs/non-empty-string"},
        "description": {"type": ["string", "null"]}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["source", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/non-empty-string"},
        "source": {"$ref": "#/$defs/non-empty-string"},
        "target": {"$ref": "#/$defs/non-empty-string"},
        "kind": {"enum": ["sequence-flow", "conditional-flow", "exception-flow"]},
        "label": {"type": ["string", "null"]}
      }
    }
  }
}
