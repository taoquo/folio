{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/pyramid.schema.json",
  "title": "Folio Pyramid Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "title",
    "levels"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "kind": {
      "const": "pyramid"
    },
    "title": {
      "$ref": "#/$defs/non-empty-string"
    },
    "orientation": {
      "enum": [
        "up",
        "down"
      ]
    },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/level"
      }
    },
    "focus": {
      "$ref": "#/$defs/non-empty-string"
    },
    "width": {
      "type": "integer",
      "minimum": 320
    },
    "height": {
      "type": "integer",
      "minimum": 240
    },
    "language": {
      "$ref": "#/$defs/non-empty-string"
    }
  },
  "$defs": {
    "non-empty-string": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non-empty-string"
        },
        "label": {
          "$ref": "#/$defs/non-empty-string"
        },
        "detail": {
          "$ref": "#/$defs/non-empty-string"
        },
        "emphasis": {
          "enum": [
            "focal",
            "normal"
          ]
        }
      }
    }
  }
}
