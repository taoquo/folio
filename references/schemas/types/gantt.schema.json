{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/gantt.schema.json",
  "title": "Folio Gantt Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "title",
    "periods",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "kind": {
      "const": "gantt"
    },
    "title": {
      "$ref": "#/$defs/non-empty-string"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/non-empty-string"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "milestones": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "focus": {
      "$ref": "#/$defs/non-empty-string"
    },
    "unit": {
      "type": "string",
      "maxLength": 12
    },
    "locale": {
      "enum": [
        "en-US",
        "en-GB",
        "zh-CN",
        "zh-TW"
      ]
    },
    "source": {
      "type": "string",
      "maxLength": 256
    },
    "value_format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "compact": {
          "type": "boolean"
        },
        "grouping": {
          "type": "boolean"
        },
        "unit_position": {
          "enum": [
            "auto",
            "prefix",
            "suffix"
          ]
        }
      }
    },
    "width": {
      "const": 960
    },
    "height": {
      "const": 540
    },
    "language": {
      "$ref": "#/$defs/non-empty-string"
    }
  },
  "$defs": {
    "non-empty-string": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "start",
        "span"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non-empty-string"
        },
        "label": {
          "$ref": "#/$defs/non-empty-string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "span": {
          "type": "integer",
          "minimum": 1
        },
        "track": {
          "$ref": "#/$defs/non-empty-string"
        },
        "emphasis": {
          "enum": [
            "focal",
            "normal"
          ]
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/non-empty-string"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "at": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
