{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/tree.schema.json",
  "title": "Folio Tree Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "nodes", "relations"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "kind": {"const": "tree"},
    "title": {"$ref": "#/$defs/non-empty-string"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 15, "items": {"$ref": "#/$defs/node"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "focus_root": {"type": ["string", "null"]},
    "width": {"const": 960},
    "height": {"type": "integer", "minimum": 500, "maximum": 800, "multipleOf": 4},
    "language": {"$ref": "#/$defs/nullable-string"}
  },
  "$defs": {
    "nullable-string": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/non-empty-string"}]},
    "non-empty-string": {"type": "string", "pattern": ".*\\S.*"},
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/non-empty-string"}, "label": {"$ref": "#/$defs/non-empty-string"},
        "subtitle": {"type": ["string", "null"]}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["id", "parent", "child"],
      "properties": {
        "id": {"$ref": "#/$defs/non-empty-string"}, "parent": {"$ref": "#/$defs/non-empty-string"},
        "child": {"$ref": "#/$defs/non-empty-string"}
      }
    }
  }
}
