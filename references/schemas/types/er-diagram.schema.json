{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/types/er-diagram.schema.json",
  "title": "Folio Entity Relationship Diagram Authoring Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "entities", "relationships"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "kind": {"const": "er-diagram"},
    "title": {"$ref": "#/$defs/text"},
    "entities": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/entity"}},
    "relationships": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/relationship"}},
    "focus_entity": {"type": ["string", "null"]},
    "width": {"const": 960},
    "height": {"type": "integer", "minimum": 480, "maximum": 800, "multipleOf": 4},
    "language": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": ".*\\S.*", "maxLength": 64},
    "field": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "type"],
      "properties": {
        "id": {"type": "string", "pattern": ".*\\S.*", "maxLength": 32},
        "name": {"type": "string", "pattern": ".*\\S.*", "maxLength": 32},
        "type": {"type": "string", "pattern": ".*\\S.*", "maxLength": 32},
        "primary_key": {"type": "boolean"},
        "foreign_key": {"type": "boolean"},
        "nullable": {"type": "boolean"}
      },
      "not": {
        "required": ["primary_key", "nullable"],
        "properties": {"primary_key": {"const": true}, "nullable": {"const": true}}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "fields"],
      "properties": {
        "id": {"type": "string", "pattern": ".*\\S.*", "maxLength": 40},
        "name": {"type": "string", "pattern": ".*\\S.*", "maxLength": 40},
        "fields": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/field"}}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "target", "label", "source_cardinality", "target_cardinality"],
      "properties": {
        "id": {"type": "string", "pattern": ".*\\S.*", "maxLength": 40},
        "source": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"},
        "label": {"type": "string", "pattern": ".*\\S.*", "maxLength": 40},
        "source_cardinality": {"enum": ["one", "zero-or-one", "many", "one-or-many"]},
        "target_cardinality": {"enum": ["one", "zero-or-one", "many", "one-or-many"]}
      }
    }
  }
}
