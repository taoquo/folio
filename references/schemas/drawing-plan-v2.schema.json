{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.local/schemas/drawing-plan-v2.schema.json",
  "title": "Folio Architecture DrawingPlan V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "composition", "hierarchy", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "kind": {"const": "architecture"},
    "title": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "width": {"type": "integer", "minimum": 320},
    "height": {"type": "integer", "minimum": 240},
    "subtitle": {"type": ["string", "null"]},
    "caption": {"type": ["string", "null"]},
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "axis"],
      "properties": {
        "pattern": {"enum": ["layered", "pipeline", "hub"]},
        "axis": {"enum": ["top-down", "left-right"]},
        "density": {"enum": ["restrained", "balanced", "dense"]},
        "spine": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "sidecars": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "focus_node": {"type": ["string", "null"]},
        "focus_path": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "background_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "label", "members", "treatment"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "members": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "treatment": {"enum": ["layer-band", "soft-boundary", "trust-boundary", "phase-band", "none"]}
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "archetype", "emphasis", "content"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "archetype": {"enum": ["component", "datastore", "external", "cloud"]},
          "emphasis": {"enum": ["focal", "normal", "background"]},
          "region": {"type": ["string", "null"]},
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "eyebrow": {"type": ["string", "null"]},
              "title": {"type": "string", "minLength": 1},
              "metadata": {"type": ["string", "null"]},
              "description": {"type": ["string", "null"]},
              "metadata_required": {"type": "boolean"}
            }
          },
          "pictogram": {
            "type": ["string", "null"],
            "enum": [null, "client", "gateway", "compute", "queue", "database", "cache", "storage", "cloud", "security", "observability", "network", "external-system"]
          },
          "size_tier": {"enum": ["compact", "regular", "wide"]}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "channel", "emphasis"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "channel": {"enum": ["primary-flow", "secondary-flow", "async-flow"]},
          "emphasis": {"enum": ["focal", "normal", "background"]},
          "label": {"type": ["string", "null"]},
          "direction": {"const": "forward"},
          "route_policy": {"const": "auto"}
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "target_kind", "kind", "text"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "target_kind": {"enum": ["node", "edge", "region", "diagram"]},
          "kind": {"enum": ["note", "constraint", "risk", "navigation"]},
          "text": {"type": "string", "minLength": 1},
          "emphasis": {"enum": ["normal", "background"]}
        }
      }
    },
    "legend": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "label"],
            "properties": {
              "channel": {"enum": ["primary-flow", "secondary-flow", "async-flow"]},
              "label": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "explanation": {"type": "array", "items": {"type": "string"}},
    "reductions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "targets", "reason", "applied"],
        "properties": {
          "action": {"enum": ["merge", "drop", "background", "split"]},
          "targets": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1},
          "applied": {"type": "boolean"}
        }
      }
    }
  }
}
